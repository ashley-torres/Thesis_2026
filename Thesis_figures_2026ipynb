    "print(f\"NDVI Model  R²: {ndvi_res['metrics']['R2']:.4f}   p = {fmt_p(ndvi_res['metrics']['p_model'])}\")\n",
    "print(f\"SIF  Params     A: p = {fmt_p(sif_res['params']['p_A'])}   b: p = {fmt_p(sif_res['params']['p_b'])}\")\n",
    "print(f\"NDVI Params     A: p = {fmt_p(ndvi_res['params']['p_A'])}   b: p = {fmt_p(ndvi_res['params']['p_b'])}\")\n",
    "print(\"=\"*55)\n",
