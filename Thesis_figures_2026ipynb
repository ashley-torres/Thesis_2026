    "# Parameters\n",
    "A, b = 1.0, 0.25\n",
    "t_max = 16\n",
    "\n",
    "# Define the fire drop (t < 0) - conceptual steep slope\n",
    "# We define a small \"pre-fire\" period for visual drop\n",
    "fire_duration = 0.5  # conceptualize fire drop happening over 0.5 years\n",
    "fire_start_t = -fire_duration\n",
    "fire_drop_t = np.array([fire_start_t, 0])\n",
    "# Start at 0 (reference level) and drop to -A\n",
    "fire_drop_y = np.array([0, -A])\n",
    "\n",
    "# recovery curve (t >= 0)\n",
    "t_curve = np.linspace(0, t_max, 500)\n",
    "y_curve = recovery_model(t_curve, A, b)\n",
    "\n",
    "# proportional thresholds \n",
    "p_levels = [0.5, 0.75, 0.85, 0.9, 0.95]\n",
    "\n",
    "#plot \n",
    "fig, ax = plt.subplots(figsize=(12, 7))\n",
    "\n",
    "# Fire Event (a steep drop)\n",
    "ax.plot(fire_drop_t, fire_drop_y, color='gray', linestyle='-', lw=2.5, zorder=3)\n",
    "\n",
    "# label fire event and intitial drop\n",
    "ax.scatter(fire_start_t, 0, color='gray', s=40, zorder=4, edgecolors='black')\n",
    "ax.scatter(0, -A, color='black', s=60, zorder=5, edgecolors='white') # A initial drop\n",
    "\n",
    "# MODEL: Recovery Curve (t >= 0)\n",
    "ax.plot(t_curve, y_curve, color=\"darkgreen\", lw=3.5, label=r\"$D(t) = -A e^{-bt}$\", zorder=3)\n",
    "\n",
    "# projection and label RTp\n",
    "for p in p_levels:\n",
    "    y_level = -A * (1 - p)\n",
    "    t_intersect = get_t_at_p(p, b)\n",
    "    \n",
    "    # Draw horizontal projection to the curve\n",
    "    ax.hlines(y_level, xmin=0.8, xmax=t_intersect, color='red', linestyle='--', alpha=0.9, lw=1.5, zorder=2)\n",
    "    \n",
    "    # Draw vertical projection down to the x-axis\n",
    "    ax.vlines(t_intersect, ymin=-1.1, ymax=y_level, color='gray', linestyle=':', alpha=0.5, zorder=1)\n",
    "    \n",
    "    # Mark intersection dot\n",
    "    ax.scatter(t_intersect, y_level, color='red', s=35, zorder=4, edgecolors='white')\n",
    "    \n",
    "    # label y-axis proportion\n",
    "    ax.text(0.9, y_level, f\"p={int(p*100)}%\", color='red', va='center', ha='right', fontsize=11)\n",
    "    \n",
    "    # label x-axis value (RT)\n",
    "    ax.text(t_intersect, -1.15, f\"{t_intersect:.1f}y\", color='black', ha='center', fontsize=8)\n",
    "\n",
    "# format -----\n",
    "\n",
    "ax.axhline(0, color='black', lw=1, alpha=0.5) # zero baseline\n",
    "\n",
    "ax.set_title(\"Mathematical Schematic: Recovery Time ($RT_p$) Model\", fontsize=15, fontweight=\"bold\", pad=20)\n",
    "ax.set_xlabel(\"Years Since Fire ($t$)\", fontsize=13)\n",
    "ax.set_ylabel(\"Vegetation Difference ($D$)\", fontsize=15)\n",
    "\n",
    "# labels \n",
    "ax.text(fire_start_t, 0.03, \"Ref. Level\", fontsize=12, fontweight='bold', color='gray', ha='center')\n",
