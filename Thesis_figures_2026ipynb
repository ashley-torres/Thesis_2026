   "source": [
    "## NDVI \n",
    "years_ba = range(2001, 2024)\n",
    "\n",
    "def get_ndvi_recovery_curves(ba, lc_2_23, ndvi, frp, bp, years_ba):\n",
    "    T_ba, H, W = ba.shape\n",
    "    forest_mask = (lc_2_23 == 0)\n",
    "\n",
    "    diff_series_list = []\n",
    "    years_since_fire_list = []\n",
    "    fire_stats_list = []\n",
    "    max_length = 0\n",
    "\n",
    "    for i, fire_year in enumerate(years_ba):\n",
    "        if i == 0:          # exclude 2001 fires so that samples match SIF\n",
    "            continue\n",
    "\n",
    "\n",
    "        bp_start = fire_year - 1980\n",
    "\n",
    "            \n",
    "        ndvi_start = i      # (t-1 = year before fire)\n",
    "        frp_start = i\n",
    "\n",
    "            \n",
    "        burned_forest_pixels = (ba[i] == 1) & forest_mask[i]\n",
    "        coords = np.argwhere(burned_forest_pixels)\n",
    "\n",
    "        for row, col in coords:\n",
    "            # Spatial search for neighbors\n",
    "            r_min, r_max = max(0, row - 2), min(H, row + 3)\n",
    "            c_min, c_max = max(0, col - 2), min(W, col + 3)\n",
    "            \n",
    "            ref_mask = (forest_mask[i, r_min:r_max, c_min:c_max]) & \\\n",
    "                       (ba[i, r_min:r_max, c_min:c_max] == 0)\n",
    "            \n",
    "            if not np.any(ref_mask):\n",
    "                continue \n",
    "\n",
    "            # Temporal end point\n",
    "            next_fire_idx = None\n",
    "            for future_year_idx in range(i + 1, T_ba):\n",
    "                if ba[future_year_idx, row, col] == 1:\n",
    "                    next_fire_idx = future_year_idx\n",
    "                    break\n",
    "            # ndvi_end \n",
    "            ndvi_end = (next_fire_idx + 1) if next_fire_idx is not None else ndvi.shape[0]\n",
    "            \n",
    "            # Extract and Difference\n",
    "            burned_ndvi = ndvi[ndvi_start:ndvi_end, row, col]\n",
    "            ref_ndvi_window = ndvi[ndvi_start:ndvi_end, r_min:r_max, c_min:c_max]\n",
    "            ref_trajectory = np.mean(ref_ndvi_window[:, ref_mask], axis=1)\n",
    "\n",
    "            # vegetation difference \n",
    "            diff_trajectory = burned_ndvi - ref_trajectory\n",
    "\n",
    "            # alignment \n",
    "            years_since_fire = np.arange(-1, len(diff_trajectory) - 1)\n",
    "\n",
    "            diff_series_list.append(diff_trajectory)\n",
    "            years_since_fire_list.append(years_since_fire)\n",
    "            max_length = max(max_length, len(diff_trajectory))\n",
    "\n",
    "            # Fire Stats\n",
    "            intensity = frp[frp_start, row, col] * 0.1\n",
    "            size = bp[bp_start, row, col] / 4046.86\n",
    "            \n",
    "            # History\n",
    "            burn_history = -1 \n",
    "            for prev_idx in reversed(range(i)):\n",
    "                if ba[prev_idx, row, col] == 1:\n",
    "                    burn_history = i - prev_idx\n",
    "                    break\n",
    "            if burn_history == -1:\n",
    "                for pb in reversed(range(bp_start)):\n",
    "                    if bp[pb, row, col] > 0:\n",
    "                        burn_history = bp_start - pb\n",
    "                        break\n",
    "\n",
    "            fire_stats_list.append([fire_year, len(diff_trajectory)-1, intensity, size, burn_history])\n",
    "\n",
    "    # Standard padding logic\n",
    "    n_samples = len(diff_series_list)\n",
    "    recovery_array = np.full((n_samples, max_length), np.nan, dtype=np.float32)\n",
    "    years_array = np.full((n_samples, max_length), np.nan, dtype=np.float32)\n",
    "\n",
    "    for idx, (d, y) in enumerate(zip(diff_series_list, years_since_fire_list)):\n",
    "        recovery_array[idx, :len(d)] = d\n",
    "        years_array[idx, :len(y)] = y\n",
    "\n",
    "    return recovery_array, years_array, np.array(fire_stats_list)\n",
    "\n",
    "\n",
    "# Ensure types are correct for memory efficiency\n",
    "ndvi = ndvi.astype(np.float32)\n",
    "frp = frp.astype(np.float32)\n",
    "bp = bp.astype(np.float32)\n",
    "ba = ba.astype(np.float32)\n",
    "\n",
    "#execution \n",
    "\n",
    "recovery_array_ndvi, years_since_fire_array, fire_stats_by_n = get_ndvi_recovery_curves(\n",
    "    ba, lc_2, ndvi, frp, bp, years_ba\n",
    ")\n",
    "print(f\"Processed {recovery_array_ndvi.shape[0]} recovery curves.\")"
   ]
