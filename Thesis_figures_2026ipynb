    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "from matplotlib.path import Path\n",
    "import matplotlib.patches as patches\n",
    "from collections import defaultdict, Counter\n",
    "\n",
    "# can remove barren because count was 29. \n",
    "\n",
    "LC_LABELS = {0: 'Forest', 1: 'Shrub', 2: 'Grassland'}\n",
    "LC_COLORS = {0: '#2d6a4f', 1: '#d4a017', 2: '#8db87a'}\n",
    "\n",
    "flow_fire_to_1yr = defaultdict(int)\n",
    "flow_1yr_to_15yr = defaultdict(int)\n",
    "for lc_fire, lc_1yr, lc_15yr in transitions:\n",
    "    if any(lc not in [0,1,2] for lc in [lc_fire, lc_1yr, lc_15yr]):\n",
    "        continue  # skip any transition involving barren\n",
    "    flow_fire_to_1yr[(lc_fire, lc_1yr)] += 1\n",
    "    flow_1yr_to_15yr[(lc_1yr, lc_15yr)] += 1\n",
    "\n",
    "def get_totals(flows, stage):\n",
    "    totals = defaultdict(int)\n",
    "    for (a, b), count in flows.items():\n",
    "        if stage == 'source': totals[a] += count\n",
    "        else: totals[b] += count\n",
    "    return totals\n",
    "\n",
    "totals_fire = get_totals(flow_fire_to_1yr, 'source')\n",
    "totals_1yr  = get_totals(flow_fire_to_1yr, 'target')\n",
    "totals_15yr = get_totals(flow_1yr_to_15yr, 'target')\n",
    "\n",
    "def compute_node_positions(totals):\n",
    "    positions = {}\n",
    "    gap = 0.02\n",
    "    total = sum(totals.values())\n",
    "    y = 0.05\n",
    "    for lc in [0, 1, 2]:\n",
    "        if lc not in totals:\n",
    "            continue\n",
    "        height = max((totals[lc] / total) * 0.9, 0.008)  # min height so barren visible\n",
    "        positions[lc] = (y, y + height)\n",
    "        y += height + gap\n",
    "    return positions\n",
    "\n",
    "pos_fire = compute_node_positions(totals_fire)\n",
    "pos_1yr  = compute_node_positions(totals_1yr)\n",
    "pos_15yr = compute_node_positions(totals_15yr)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 8))\n",
    "ax.set_xlim(0, 10)\n",
    "ax.set_ylim(0, 1)\n",
    "ax.axis('off')\n",
    "\n",
    "stage_x     = [1.0, 5.0, 9.0]\n",
    "stage_titles = ['At Fire', '1yr After', '15yrs After']\n",
    "bar_width   = 0.3\n",
    "total_n     = len(transitions)\n",
    "\n",
    "# Draw node bars\n",
    "for lc in range(4):\n",
    "    for pos, x in [(pos_fire, stage_x[0]),\n",
    "                   (pos_1yr,  stage_x[1]),\n",
    "                   (pos_15yr, stage_x[2])]:\n",
    "        if lc not in pos:\n",
    "            continue\n",
    "        y0, y1 = pos[lc]\n",
    "        ax.add_patch(plt.Rectangle(\n",
    "            (x - bar_width/2, y0), bar_width, y1 - y0,\n",
    "            color=LC_COLORS[lc], zorder=3\n",
    "        ))\n",
    "        # Only label if tall enough\n",
    "        if (y1 - y0) > 0.03:\n",
    "            ax.text(x, (y0 + y1) / 2, LC_LABELS[lc],\n",
    "                    ha='center', va='center',\n",
    "                    fontsize=8, fontweight='bold',\n",
    "                    color='white', zorder=4)\n",
    "\n",
    "# Percentages\n",
    "total_fire  = sum(totals_fire.values())\n",
    "total_1yr  = sum(totals_1yr.values())\n",
    "total_15yr  = sum(totals_15yr.values())\n",
    "\n",
    "for lc in range(3):\n",
    "    # Left side — At Fire\n",
    "    if lc in pos_fire:\n",
    "        y0, y1 = pos_fire[lc]\n",
