    "# define the model \n",
    "\n",
    "def recovery_model(t, A, b):\n",
    "    return -A * np.exp(-b * t)\n",
    "\n",
    "def RT_p(p, b):\n",
    "    return -np.log(1 - p) / b\n",
    "\n",
    "get_t_at_p = RT_p # rename for downstream code"
   ]
  },
  {
   "cell_type": "code",
