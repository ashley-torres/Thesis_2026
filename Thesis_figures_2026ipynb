    "def fit_sensor_recovery(data_array, t_axis, sensor_name, max_year=13):\n",
    "    t_points = []\n",
    "    mean_points = []\n",
    "    for t_val in range(1, max_year + 1):\n",
    "        mask = (t_axis == t_val)\n",
    "        if not np.any(mask):\n",
    "            continue\n",
    "        values = data_array[:, mask].flatten()\n",
    "        values = values[~np.isnan(values)]\n",
    "        if len(values) > 0:\n",
    "            t_points.append(t_val)\n",
    "            mean_points.append(np.mean(values))\n",
    "    t_points    = np.array(t_points)\n",
    "    mean_points = np.array(mean_points)\n",
    "    A0      = mean_points[0]  # keep sign\n",
    "    a_lower = -500.0 if 'SIF' in sensor_name else -2.0\n",
    "    a_upper =  500.0 if 'SIF' in sensor_name else  2.0\n",
    "    popt, pcov = curve_fit(\n",
    "        recovery_model, t_points, mean_points,\n",
    "        p0=[A0, 0.1], bounds=([a_lower, 0.001], [a_upper, 1.0]),\n",
    "        maxfev=10000\n",
    "    )\n",
    "    A_fit, b_fit = popt\n",
    "\n",
    "    # p values \n",
    "    perr     = np.sqrt(np.diag(pcov))\n",
    "    dof      = len(t_points) - 2\n",
    "    t_stats  = popt / perr\n",
    "    p_A, p_b = 2 * t_dist.sf(np.abs(t_stats), df=dof)\n",
    "\n",
    "    thresholds = [0.50, 0.75, 0.80, 0.85, 0.90, 0.95]\n",
    "    rt_results = {f'RT{int(p*100)}': -np.log(1 - p) / b_fit for p in thresholds}\n",
    "    preds  = recovery_model(t_points, A_fit, b_fit)\n",
    "    ss_res = np.sum((mean_points - preds) ** 2)\n",
    "    ss_tot = np.sum((mean_points - np.mean(mean_points)) ** 2)\n",
    "    r2     = 1 - (ss_res / ss_tot) if ss_tot != 0 else 1.0\n",
    "\n",
    "    # f test \n",
    "    ms_reg  = (ss_tot - ss_res) / 1\n",
    "    ms_res  = ss_res / dof if dof > 0 else np.nan\n",
    "    f_stat  = ms_reg / ms_res if (ms_res and ms_res > 0) else np.nan\n",
    "    p_model = f_dist.sf(f_stat, dfn=1, dfd=dof) if not np.isnan(f_stat) else np.nan\n",
    "\n",
    "    return {\n",
    "        'sensor':  sensor_name,\n",
    "        'metrics': {'R2': r2, 'p_model': p_model, **rt_results},\n",
    "        'params':  {'A': A_fit, 'b': b_fit, 'p_A': p_A, 'p_b': p_b},\n",
    "        'data':    {'t': t_points, 'obs': mean_points, 'pred': preds}\n",
    "    }\n",
    "\n",
    "def fmt_p(p):\n",
    "    return '< 0.001' if p < 0.001 else f'{p:.3f}'\n",
    "\n",
    "# corrected time axes (shift by -1 so fire year = t=0)\n",
    "t_axis_ndvi = years_since_fire_array[0, :n_diffs_f.shape[1]] - 1\n",
    "t_axis_sif  = years_since_fire_array[0, :s_diffs_f.shape[1]] - 1\n",
    "ndvi_res = fit_sensor_recovery(n_diffs_f, t_axis_ndvi, \"NDVI (Structural)\")\n",
    "sif_res  = fit_sensor_recovery(s_diffs_f, t_axis_sif,  \"SIF (Functional)\")\n",
    "\n",
    "# table to compare\n",
    "data = []\n",
    "for rt in ['RT50', 'RT75', 'RT80', 'RT85', 'RT90', 'RT95']:\n",
    "    s_val = sif_res['metrics'][rt]\n",
    "    n_val = ndvi_res['metrics'][rt]\n",
    "    data.append({\n",
    "        'Threshold':         rt,\n",
    "        'SIF [Years]':       round(s_val, 2),\n",
    "        'NDVI [Years]':      round(n_val, 2),\n",
    "        'Lag (N-S) [Years]': round(n_val - s_val, 2)\n",
    "    })\n",
    "df_rt = pd.DataFrame(data)\n",
