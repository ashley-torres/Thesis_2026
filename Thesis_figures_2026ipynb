    "            fontsize=12, fontweight='bold', color='#1a3a5c')\n",
    "\n",
    "ax.set_title(\n",
    "    f\"Fire Succession Pathways: At Fire → 1yr After → 15yrs After  (N={total_n:,})\",\n",
    "    fontsize=13, fontweight='bold', color='#1a3a5c', pad=15\n",
    ")\n",
    "\n",
    "legend_patches = [mpatches.Patch(color=LC_COLORS[lc], label=LC_LABELS[lc])\n",
    "                  for lc in range(3)]\n",
    "ax.legend(handles=legend_patches, loc='lower center', ncol=4,\n",
    "          frameon=True, fontsize=10, bbox_to_anchor=(0.5, 0))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(dir + \"/sankey_lc_succession_final.png\", dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
