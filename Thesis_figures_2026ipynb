    "### get test statistics\n",
    "\n",
    "def model_stats(popt, pcov, t_pts, path, valid):\n",
    "    A_fit, b_fit = popt\n",
    "    obs   = path[valid]\n",
    "    preds = recovery_model(t_pts[valid], A_fit, b_fit)\n",
    "    ss_res = np.sum((obs - preds) ** 2)\n",
    "    ss_tot = np.sum((obs - np.mean(obs)) ** 2)\n",
    "    r2     = 1 - (ss_res / ss_tot) if ss_tot != 0 else 1.0\n",
    "    dof    = len(obs) - 2\n",
    "    perr   = np.sqrt(np.diag(pcov))\n",
    "    t_stats = popt / perr\n",
    "    p_A, p_b = 2 * t_dist.sf(np.abs(t_stats), df=dof)\n",
    "    ms_reg  = (ss_tot - ss_res) / 1\n",
    "    ms_res  = ss_res / dof if dof > 0 else np.nan\n",
    "    f_stat  = ms_reg / ms_res if (ms_res and ms_res > 0) else np.nan\n",
    "    p_model = f_dist.sf(f_stat, dfn=1, dfd=dof) if not np.isnan(f_stat) else np.nan\n",
    "    return r2, p_model, p_A, p_b\n",
    "\n",
    "r2_n, p_model_n, p_A_n, p_b_n = model_stats(popt_n, pcov_n, t_n, path_n, valid_n)\n",
    "r2_s, p_model_s, p_A_s, p_b_s = model_stats(popt_s, pcov_s, t_s, path_s, valid_s)\n",
    "\n",
    "print(\"=\"*55)\n",
    "print(f\"{'EXTREME FIRE MODEL FIT STATISTICS':^55}\")\n",
    "print(\"=\"*55)\n",
