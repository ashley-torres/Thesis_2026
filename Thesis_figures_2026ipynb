    "                ha='right', va='center', fontsize=15, color=LC_COLORS[lc],\n",
    "                fontweight='bold')\n",
    "\n",
    "    # Middle — 1yr After\n",
    "    if lc in pos_1yr:\n",
    "        y0, y1 = pos_1yr[lc]\n",
    "        pct = totals_1yr[lc] / total_1yr * 100\n",
    "        ax.text(stage_x[1] - bar_width/2 - 0.1, (y0 + y1) / 2,\n",
    "                f'{pct:.1f}%',\n",
    "                ha='right', va='center', fontsize=15, color=LC_COLORS[lc],\n",
    "                fontweight='bold')\n",
    "\n",
    "    # Right side — 15yrs After\n",
    "    if lc in pos_15yr:\n",
    "        y0, y1 = pos_15yr[lc]\n",
    "        pct = totals_15yr[lc] / total_15yr * 100\n",
    "        ax.text(stage_x[2] + bar_width/2 + 0.1, (y0 + y1) / 2,\n",
    "                f'{pct:.1f}%',\n",
    "                ha='left', va='center', fontsize=15, color=LC_COLORS[lc],\n",
    "                fontweight='bold')\n",
    "\n",
    "def draw_flow(ax, x0, x1, y0_bot, y0_top, y1_bot, y1_top, color):\n",
    "    cx = (x0 + x1) / 2\n",
    "    verts = [\n",
    "        (x0, y0_top),\n",
    "        (cx, y0_top), (cx, y1_top), (x1, y1_top),\n",
    "        (x1, y1_bot),\n",
    "        (cx, y1_bot), (cx, y0_bot), (x0, y0_bot),\n",
    "    ]\n",
    "    codes = [Path.MOVETO, Path.CURVE4, Path.CURVE4, Path.CURVE4,\n",
    "             Path.LINETO, Path.CURVE4, Path.CURVE4, Path.CURVE4]\n",
    "    path  = Path(verts, codes)\n",
    "    patch = patches.PathPatch(path, facecolor=color, edgecolor='none',\n",
    "                               alpha=0.35, zorder=1)\n",
    "    ax.add_patch(patch)\n",
    "\n",
    "def hex_to_rgb(hex_col):\n",
    "    hex_col = hex_col.lstrip('#')\n",
    "    r, g, b = tuple(int(hex_col[i:i+2], 16) for i in (0, 2, 4))\n",
    "    return r/255, g/255, b/255\n",
    "\n",
    "fill_fire_out = {lc: pos_fire[lc][0] for lc in pos_fire}\n",
    "fill_1yr_in   = {lc: pos_1yr[lc][0]  for lc in pos_1yr}\n",
    "fill_1yr_out  = {lc: pos_1yr[lc][0]  for lc in pos_1yr}\n",
    "fill_15yr_in  = {lc: pos_15yr[lc][0] for lc in pos_15yr}\n",
    "\n",
    "total_n_flow  = sum(flow_fire_to_1yr.values())\n",
    "total_n_flow2 = sum(flow_1yr_to_15yr.values())\n",
    "\n",
    "for (lc_a, lc_b), count in sorted(flow_fire_to_1yr.items()):\n",
    "    frac  = count / total_n_flow * 0.9\n",
    "    y0_bot = fill_fire_out[lc_a]; y0_top = y0_bot + frac\n",
    "    fill_fire_out[lc_a] = y0_top\n",
    "    y1_bot = fill_1yr_in[lc_b];  y1_top = y1_bot + frac\n",
    "    fill_1yr_in[lc_b] = y1_top\n",
    "    r, g, b = hex_to_rgb(LC_COLORS[lc_a])\n",
    "    draw_flow(ax, stage_x[0] + bar_width/2, stage_x[1] - bar_width/2,\n",
    "              y0_bot, y0_top, y1_bot, y1_top, (r, g, b))\n",
    "\n",
    "for (lc_a, lc_b), count in sorted(flow_1yr_to_15yr.items()):\n",
    "    frac  = count / total_n_flow2 * 0.9\n",
    "    y0_bot = fill_1yr_out[lc_a]; y0_top = y0_bot + frac\n",
    "    fill_1yr_out[lc_a] = y0_top\n",
    "    y1_bot = fill_15yr_in[lc_b]; y1_top = y1_bot + frac\n",
    "    fill_15yr_in[lc_b] = y1_top\n",
    "    r, g, b = hex_to_rgb(LC_COLORS[lc_a])\n",
    "    draw_flow(ax, stage_x[1] + bar_width/2, stage_x[2] - bar_width/2,\n",
    "              y0_bot, y0_top, y1_bot, y1_top, (r, g, b))\n",
